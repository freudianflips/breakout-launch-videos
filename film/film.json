{
  "brand": "../brand",
  "voice_dir": "vo/body",
  "gap": 0.3,
  "lockup": "logo",
  "lines": {
    "02": "Breakout is your inbound SDR, powered by AI.",
    "03": "It identifies every visitor: the company, the person, the intent.",
    "04": "It engages them in real time, answers questions and books the meeting.",
    "05": "And when they leave, it follows up over email and LinkedIn.",
    "06": "Identify, engage, convert. One AI SDR.",
    "07": "A full-time, always-on SDR."
  },
  "music": {
    "file": "score/bed.wav",
    "bpm": 120,
    "drop": 6.0,
    "gain_db": -3
  },
  "sound": {
    "kit": null,
    "key": "A"
  },
  "beats": [
    {"type": "name", "line": "02", "tagline": "is your *inbound *SDR, powered by AI."},
    {"type": "hero", "line": "03", "ground": "dark", "text": "Every *visitor.", "exit": "dive", "until": "visitor+0.35"},
    {"type": "product", "line": "03", "src": "assets/screens/visitors.png", "focus": [0.18, 0.33, 0.3, 0.4], "push_at": "company",
     "chip": {"text": "Identified", "at": "intent"}},
    {"type": "hero", "line": "04", "ground": "accent", "text": "In *real *time.", "exit": "collapse", "until": "time+0.3"},
    {"type": "product", "line": "04", "src": "assets/screens/chat.png", "focus": [0.45, 0.33, 0.55, 0.4], "push_at": "answers",
     "cursor": {"at": "books", "x": 0.86, "y": 0.45}, "chip": {"text": "Meeting booked", "at": "meeting"}},
    {"type": "product", "line": "05", "src": "assets/screens/followup.png", "focus": [0.18, 0.33, 0.58, 0.4], "push_at": "follows",
     "chip": {"text": "Followed up", "at": "linkedin"}},
    {"type": "blocks", "line": "06", "items": ["Identify", "Engage", "Convert"], "merge_at": "one", "label": "One *AI *SDR."},
    {"type": "switch", "line": "07", "text": "Inbound SDR, *always *on.", "flip_at": "always"},
    {"type": "end", "hold": 3.5}
  ]
}
